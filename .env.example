# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Live Market Data Provider Keys (Server-Side Only — Never Exposed to Browser)
# Zero-key endpoints (Binance Public REST/WS, SEC EDGAR, Alpha Vantage IBM demo) work automatically.
FINNHUB_API_KEY=""
ALPACA_KEY_ID=""
ALPACA_SECRET_KEY=""
ALPHA_VANTAGE_API_KEY=""
FMP_API_KEY=""
SEC_USER_AGENT="Financia ResearchEngine/1.0 (subashree04116@gmail.com)"
MARKET_DATA_BASE_URL=""
MARKET_DATA_API_KEY=""
FOREX_API_KEY=""
NEWS_API_KEY=""
